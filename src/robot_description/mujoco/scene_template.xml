<mujoco model="forge_preview">
  <include file="robot.xml"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <asset>
    <texture name="bright_background" type="skybox" builtin="gradient"
             rgb1="0.72 0.80 0.90" rgb2="0.93 0.95 0.98" width="512" height="3072"/>
  </asset>
  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.5 0.5 0.5" specular="0.2 0.2 0.2"/>
    <rgba haze="0.75 0.80 0.86 1"/>
  </visual>
  <!-- Demo magnetic parameters: force N, cutoff m, decay length m. Not calibrated. -->
  <custom>
    <text name="magnetic_bodies" data="linkage_wheel_1 linkage_wheel_2 linkage_wheel_3 linkage_wheel_4 linkage_wheel_5 linkage_wheel_6"/>
    <text name="magnetic_surface" data="steel_wall"/>
    <numeric name="magnetic_parameters" data="100 0.02 0.002"/>
  </custom>
  <worldbody>
    <!-- Vertical XZ steel plate: 4 m wide, 20 mm thick, 4 m tall. -->
    <geom name="steel_wall" type="box" pos="0 -0.8 2" size="2 0.01 2"
          rgba="0.45 0.52 0.60 1" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
    <light name="preview_light" pos="1 -1 3" dir="-1 1 -3"/>
    <geom name="preview_floor" type="plane" size="0 0 0.05" rgba="0.60 0.64 0.69 1"/>
  </worldbody>
</mujoco>
